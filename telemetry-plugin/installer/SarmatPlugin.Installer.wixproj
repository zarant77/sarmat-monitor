<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <OutputName>SarmatPlugins-$(ProductVersion)</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\artifacts\</OutputPath>
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      PluginDist=$(MSBuildProjectDirectory)\..\dist;
      VisionDist=$(MSBuildProjectDirectory)\..\..\vision-hold-plugin\dist;
      ThemeSource=$(MSBuildProjectDirectory)\..\..\theme
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
