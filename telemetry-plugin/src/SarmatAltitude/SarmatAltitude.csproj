<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SarmatAltitude</AssemblyName>
    <RootNamespace>SarmatAltitude</RootNamespace>
    <MissionPlannerPath Condition="'$(MissionPlannerPath)' == ''">C:\Program Files (x86)\Mission Planner</MissionPlannerPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MissionPlanner"><HintPath>$(MissionPlannerPath)\MissionPlanner.exe</HintPath><Private>false</Private></Reference>
    <Reference Include="MissionPlanner.ArduPilot"><HintPath>$(MissionPlannerPath)\MissionPlanner.ArduPilot.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MissionPlanner.Utilities"><HintPath>$(MissionPlannerPath)\MissionPlanner.Utilities.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Interfaces"><HintPath>$(MissionPlannerPath)\Interfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MAVLink"><HintPath>$(MissionPlannerPath)\MAVLink.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="ValidateMissionPlanner" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MissionPlannerPath)\MissionPlanner.exe')" Text="MissionPlanner.exe was not found at $(MissionPlannerPath). Pass -p:MissionPlannerPath=..." />
  </Target>
</Project>
