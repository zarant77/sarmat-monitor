<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SarmatTelemetry</AssemblyName>
    <RootNamespace>SarmatPlugin</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <MissionPlannerPath Condition="'$(MissionPlannerPath)' == ''">C:\Program Files (x86)\Mission Planner</MissionPlannerPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MissionPlanner">
      <HintPath>$(MissionPlannerPath)\MissionPlanner.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MissionPlanner.ArduPilot">
      <HintPath>$(MissionPlannerPath)\MissionPlanner.ArduPilot.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\warning.wav" LogicalName="SarmatPlugin.Assets.warning.wav" />
    <EmbeddedResource Include="..\..\..\shared\telemetry-thresholds.json"
                      LogicalName="SarmatPlugin.Config.telemetry-thresholds.json" />
  </ItemGroup>
  <Target Name="ValidateMissionPlanner" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MissionPlannerPath)\MissionPlanner.exe')" Text="MissionPlanner.exe was not found at $(MissionPlannerPath). Pass -p:MissionPlannerPath=..." />
  </Target>
</Project>
