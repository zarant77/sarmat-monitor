<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><TargetFramework>net472</TargetFramework><AssemblyName>SarmatVisionHold</AssemblyName><RootNamespace>SarmatVisionHold</RootNamespace><MissionPlannerPath Condition="'$(MissionPlannerPath)' == ''">C:\Program Files (x86)\Mission Planner</MissionPlannerPath></PropertyGroup>
 <ItemGroup>
  <ProjectReference Include="..\SarmatVisionHold.Core\SarmatVisionHold.Core.csproj" />
  <ProjectReference Include="..\SarmatVisionHold.Vision\SarmatVisionHold.Vision.csproj" />
  <Reference Include="MissionPlanner"><HintPath>$(MissionPlannerPath)\MissionPlanner.exe</HintPath><Private>false</Private></Reference>
  <Reference Include="MissionPlanner.ArduPilot"><HintPath>$(MissionPlannerPath)\MissionPlanner.ArduPilot.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="MAVLink"><HintPath>$(MissionPlannerPath)\MAVLink.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="System.Windows.Forms"/><Reference Include="System.Drawing"/><Reference Include="System.Runtime.Serialization"/>
  <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108"/>
  <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108"/>
 </ItemGroup>
 <ItemGroup><Compile Remove="Core\**\*.cs" /><Compile Remove="Vision\OpticalFlowTracker.cs" /><Compile Remove="Vision\SparseOpticalFlowProcessor.cs" /><Compile Remove="Vision\TemporalMotionClassifier.cs" /></ItemGroup>
 <Target Name="ValidateMissionPlanner" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(MissionPlannerPath)\MissionPlanner.exe')" Text="MissionPlanner.exe not found. Pass -p:MissionPlannerPath=..."/></Target>
</Project>
