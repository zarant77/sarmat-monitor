<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SarmatVisionHold.ReplayAnalyzer</AssemblyName>
    <RootNamespace>SarmatVisionHold.ReplayAnalyzer</RootNamespace>
    <MissionPlannerPath Condition="'$(MissionPlannerPath)' == ''">C:\Program Files (x86)\Mission Planner</MissionPlannerPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SarmatVisionHold.Replay\SarmatVisionHold.Replay.csproj" />
    <ProjectReference Include="..\..\src\SarmatVisionHold.Vision\SarmatVisionHold.Vision.csproj" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <Reference Include="MAVLink"><HintPath>$(MissionPlannerPath)\MAVLink.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <Target Name="ValidateMavlink" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MissionPlannerPath)\MAVLink.dll')" Text="MAVLink.dll not found. Pass -p:MissionPlannerPath=..." />
  </Target>
</Project>
