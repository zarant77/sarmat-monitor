<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.5.3</ProductVersion>
    <OutputName>SarmatPlugins-$(ProductVersion)</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\artifacts\</OutputPath>
    <SuppressIces>ICE61</SuppressIces>
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      PluginDist=$(MSBuildProjectDirectory)\..\telemetry-plugin\dist;
      ThemeSource=$(MSBuildProjectDirectory)\..\theme
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
