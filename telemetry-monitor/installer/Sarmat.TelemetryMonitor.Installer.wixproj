<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildProjectDirectory)\..\publish\win-x64</PublishDir>
    <OutputName>TelemetryMonitor-$(ProductVersion)-win-x64</OutputName>
    <OutputPath>$(MSBuildProjectDirectory)\..\artifacts\</OutputPath>
    <DefineConstants>
      ProductVersion=$(ProductVersion);
      PublishDir=$(PublishDir)
    </DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
