<Window x:Class="Sarmat.TelemetryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sarmat Telemetry Monitor" Height="440" Width="1220"
        MinHeight="320" MinWidth="900" WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="6" Padding="14,10"
                Margin="0,0,0,12" BorderBrush="#D1D5DB" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Aggregator:" FontWeight="SemiBold" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ConnectionStatus}" />
                <TextBlock Text="{Binding LastError}" Foreground="#B91C1C" Margin="14,0,0,0" />
            </StackPanel>
        </Border>

        <Border Background="White" CornerRadius="6" BorderBrush="#D1D5DB" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Stations}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                      AlternatingRowBackground="#F9FAFB" HorizontalGridLinesBrush="#E5E7EB"
                      FontSize="14" RowHeight="44" ColumnHeaderHeight="38">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Station" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="{Binding ColorBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTextColumn Header="Voltage" Binding="{Binding Voltage}" Width="90" />
                    <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="90" />
                    <DataGridTextColumn Header="Sat" Binding="{Binding Satellites}" Width="65" />
                    <DataGridTextColumn Header="HDOP" Binding="{Binding Hdop}" Width="75" />
                    <DataGridTextColumn Header="Heading" Binding="{Binding Heading}" Width="90" />
                    <DataGridTextColumn Header="Altitude" Binding="{Binding Altitude}" Width="90" />
                    <DataGridTextColumn Header="Ruijie" Binding="{Binding Ruijie}" Width="85" />
                    <DataGridTextColumn Header="OBS" Binding="{Binding Obs}" Width="80" />
                    <DataGridTextColumn Header="Vehicle" Binding="{Binding Armed}" Width="100" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="85" />
                    <DataGridTextColumn Header="Sequence" Binding="{Binding Sequence}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
